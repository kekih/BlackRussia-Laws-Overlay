<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#40FF5722" />
            <size android:width="64dp" android:height="64dp" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#FF1A1A1A" />
            <stroke
                android:width="2.5dp"
                android:color="#FFFF5722" />
        </shape>
    </item>
</layer-list>
